{
    "layer": "bottom",
    "position": "top",
    "modules-left": ["niri/workspaces"],
    "modules-center": ["niri/window"],
    "modules-right": ["group/group-network", "upower", "power-profiles-daemon", "pulseaudio", "cpu", "group/group-power"],

    "niri/workspaces": {
		"format": "{icon}{index} ",
		"format-icons": {
			"active": "/  ",
			"default": "/  "
		}
	},

	"niri/window": {
		"format": "{}",
		"separate-outputs": true,
		"max-length": 60
	},

	"tray": {
        "icon-size": 12,
        "spacing": 5,
        "icons": {
            "nm-applet": false
        }
    },

	"group/group-power": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 500,
			"transition-left-to-right": false,
			"children-class": "drawer"
		},
		"modules": [
			"clock",
			"custom/reboot",
			"custom/shutdown",
			"custom/quit",
			"custom/suspend",
			"inhibitor"
		]
	},

	"group/group-network": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 100,
			"transition-left-to-right": false,
			"click-to-reveal": true,
			"children-class": "drawer"
		},
		"modules": [
		    "network",
			"tray",
			"network#homelab",
			"network#vpn"
		]
	},

	"custom/quit": {
		"format": "[ 󰍃 ]",
		"tooltip": false,
		"on-click": "niri msg action quit"
	},

	"custom/reboot": {
		"format": "[  ]",
		"tooltip": false,
		"on-click": "reboot",
	},

	"custom/shutdown": {
		"format": "[ ⏻ ]",
		"tooltip": false,
		"on-click": "shutdown",
	},

	"custom/suspend": {
		"format": "[ 󰒲 ]",
		"tooltip": false,
		"on-click": "systemctl suspend"
	},

	"inhibitor": {
        "what": ["handle-lid-switch", "idle"],
        "format": "[ {icon} ]",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %b %d}",
        "tooltip": false
    },
	
	"upower": {
		"native-path": "BAT0",
		"icon-size": 16,
		"tooltip": true,
		"tooltip-spacing": 16
	},

    "network": {
        "format": "{ifname}",
        "format-wifi": "  [ {essid} ]",
        "format-ethernet": "󰛳  [ {ifname} ]",
        "format-disconnected": "[ 󱘖 ]",
        "format-disabled": "[ 󰯡 ]",
        "tooltip-format-wifi": "SIG: <b>{signalStrength}%</b>\nFREQ: <b>{frequency}GHz</b>\nIP: <b>{ipaddr}</b>\nGW: <b>{gwaddr}</b>",
        "max-length": 30,
        //"menu": "on-click",
        //"menu-file": "~/.config/waybar/network_menu.xml",
        "menu-actions": {
        	"nmtui": "kitty -e nmtui-connect",
        	"nmcm": "nm-connection-editor"
		}
    },

    "network#homelab": {
        "interface": "homelab",
        "format": " 󰲝 {ifname}",
        "format-disconnected": " 󰲝 ",
        "max-length": 30,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/homelab_vpn_menu.xml",
        "menu-actions": {
        	"hlc": "nmcli con up homelab",
        	"hld": "nmcli con down homelab",
        	"mc": "mullvad connect",
        	"md": "mullvad disconnect"
		}
    },

    "network#vpn": {
        "interface": "wg0-*",
        "format": "{ifname}",
        "format-disconnected": "",
        "max-length": 30,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/homelab_vpn_menu.xml",
        "menu-actions": {
        	"hlc": "nmcli con up homelab",
        	"hld": "nmcli con down homelab",
        	"mc": "mullvad connect",
        	"md": "mullvad disconnect"
		}
    },

    "pulseaudio": {
        "format": "{icon}  [ {volume}% ]",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },

	"power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": " ",
        "performance": " ",
        "balanced": " ",
        "power-saver": " "
      }
    },

    "cpu": {
     "interval": 1,
     "format": "{icon}",
     "format-icons": [
          "<span color='#69ff94'>▁</span>", // green
          "<span color='#2aa9ff'>▂</span>", // blue
          "<span color='#f8f8f2'>▃</span>", // white
          "<span color='#f8f8f2'>▄</span>", // white
          "<span color='#ffffa5'>▅</span>", // yellow
          "<span color='#ffffa5'>▆</span>", // yellow
          "<span color='#ff9977'>▇</span>", // orange
          "<span color='#dd532e'>█</span>"  // red
     ]
    },
},
